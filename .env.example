# URL do Backend (NestJS), usada só no servidor do Next pelo proxy /api.
# Com o docker compose, o container alcança a API do host por host.docker.internal.
API_URL=http://host.docker.internal:3001

# URL pública do bucket de imagens (SeaweedFS no desenvolvimento, Cloudflare R2 em produção)
STORAGE_PUBLIC_URL=http://localhost:8333/eldo

# Chave do site do Cloudflare Turnstile (CAPTCHA dos formulários públicos). É pública
# por natureza. A chave abaixo é a de teste da Cloudflare, que sempre passa.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
